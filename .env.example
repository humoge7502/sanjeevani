# SANJEEVANI environment template.
#
# COPY TO .env ONLY IF YOU NEED TO CHANGE SOMETHING. Every variable below has a
# working default, and the demo must run with NO environment file at all.
#
# There are no secrets in this project. The SAP surfaces are in-process mocks,
# the signal feeds are files, and the model layer is disabled. If a real
# credential ever needs to live here, it does NOT get committed: .env is ignored.
#
# Full deployment guidance: docs/deployment.md

# ---- backend ---------------------------------------------------------------
# Port is deliberately 8787, not 8000: 8000 collides with common local services.
SANJEEVANI_API_PORT=8787

# Interface to bind. The default in config/settings.yaml is 127.0.0.1, which is
# correct for a laptop and WRONG in a container (unreachable from outside it).
# The Dockerfile therefore sets 0.0.0.0.
# SANJEEVANI_API_HOST=0.0.0.0

# Comma-separated allowed browser origins. Only needed when the UI is served from
# a different origin than the API. With the single-container layout (the API
# serves frontend/dist) it is unnecessary, because same-origin needs no CORS.
# SANJEEVANI_CORS_ORIGINS=https://sanjeevani.example.com

# Where the append-only audit ledger is written. Point this at a mounted volume
# so the hash chain survives a redeploy.
# SANJEEVANI_RUNTIME_DIR=/app/runtime
# SANJEEVANI_LEDGER_PATH=runtime/audit_ledger.jsonl

# Bind a pre-built asset directory. Set when the frontend is built somewhere
# other than frontend/dist.
# SANJEEVANI_FRONTEND_DIST=/app/frontend/dist

# Repository root override. Only needed if the process starts from another cwd
# and config/ and data/ are not siblings of the backend package.
# SANJEEVANI_REPO_ROOT=/app

# Force offline mode on (accepts true/1/yes, or false/0/no to force off).
# The system is offline-first regardless; this marks the demo explicitly so no
# optional enrichment is attempted.
# SANJEEVANI_OFFLINE=true

# Which RecoveryPlan provider M3 consumes.
#   fixture     (default) the hand-set deterministic stand-in, no solver
#   optimizer   the REAL optimizer: a multi-objective binary program solved by
#               PuLP/CBC and cross-checked by exhaustive enumeration, evaluated
#               with a deterministic digital twin. Opt-in so the demo's
#               byte-reproducible numbers are untouched by default.
#   unavailable fails closed; used by the red-team suite
SANJEEVANI_PLAN_PROVIDER=fixture

# The discrete-event cross-check (backend/m2/des.py): finite berths, closure
# unions, queue waits — deterministic SimPy, no sampling, no seed. ADVISORY BY
# DEFAULT: it always runs and its verdict against the closed-form twin is
# reported in the trace (m2.des.cross_check), but it cannot veto a plan. Set
# true to make leftover corridor traffic that clears after the recovery ceiling,
# or any berth contention, a hard constraint violation.
# SANJEEVANI_M2_DES=true

# ---- authentication -------------------------------------------------------
# OFF by default, so the offline demo and the container smoke test are unchanged.
#
# Turning it ON is the difference between "anyone who can reach the port can
# approve and execute a recovery plan" and "only a verified principal holding the
# required role can". When it is on:
#   * every route except /api/health, /api/auth/token and /metrics needs a token
#   * the approver is taken FROM THE TOKEN, not from the request body
#   * the role checked is the token's role, not the seeded roster's
#   * POST /api/demo/reset requires the 'admin' role
#
# A missing or weak (<32 byte) secret is a startup failure on purpose: a
# deployment that believes it is authenticated but is not is worse than one that
# refuses to boot.
# SANJEEVANI_AUTH_ENABLED=true
# SANJEEVANI_JWT_SECRET=change-me-to-at-least-32-random-bytes-long
# SANJEEVANI_JWT_TTL_SECONDS=3600
# LOCAL DEVELOPMENT ONLY: mint a random secret per process. Invalidates every
# token on restart, and is reported in /api/health as ephemeral_jwt_secret=true.
# SANJEEVANI_ALLOW_EPHEMERAL_SECRET=1

# Accounts, roles and tenants live in config/identity.yaml, generated with:
#   python scripts/make_identity.py --demo
#   python scripts/make_identity.py --account "id:password:role:tenant:Full Name:Title"
# The shipped roster uses documented demo credentials; replace them (and rotate
# the JWT secret) before any deployment reachable from a network.

# ---- ledger attestation ----------------------------------------------------
# Optional external anchor for the audit chain (backend/audit/attestation.py,
# scripts/attest_ledger.py). The key signs the ledger HEAD and must live
# somewhere OTHER than the ledger volume -- that separation is the whole point.
#   SANJEEVANI_ATTESTATION_KEY=<32+ random bytes>   # read at call time, never stored
#   python scripts/attest_ledger.py attest   # sign the current head
#   python scripts/attest_ledger.py verify --file runtime/attestations/<file>.json

# ---- persistence -----------------------------------------------------------
# A crash-safe, QUERYABLE SQLite mirror of the append-only JSONL ledger. The JSONL
# file stays the source of truth and the only thing the hash chain covers; the
# mirror is never read to decide what happened, only to answer "find me the rows
# that match". Off by default so the file-only story stays as documented.
# Enabling it exposes GET /api/audit/index for filtered, paginated queries.
# SANJEEVANI_AUDIT_MIRROR=true

# Durability of the JSONL append itself:
#   none  write and return            (fastest; a power loss can lose the tail)
#   flush flush to the OS             (default)
#   fsync flush AND fsync             (survives a power loss; one syscall per record)
# A typo here is a STARTUP FAILURE on purpose: a silently weaker audit trail is
# worse than refusing to boot.
# SANJEEVANI_LEDGER_DURABILITY=fsync

# ---- forecasting -----------------------------------------------------------
# The trained disruption-duration model is ADVISORY. It always runs and its
# prediction is recorded on the scenario as evidence, but it does NOT change any
# number unless forecasting.enabled is set in config/settings.yaml, and even then
# A2 clamps the blend against scenario.clamp.duration_days.
#
# Train or retrain it with:
#   pip install -r requirements-ml.txt
#   python scripts/train_forecasting_model.py
#
# The artifact is portable JSON evaluated in pure Python, so numpy / scipy /
# pandas / scikit-learn are TRAINING-ONLY and never enter the runtime image.

# ---- frontend (build/dev only; not read by the running container) ----------
# Vite dev server port and the local API target it proxies /api to.
VITE_PORT=5173
VITE_API_TARGET=http://127.0.0.1:8787

# ---- optional LLM enrichment ---------------------------------------------
# DISABLED and OFF BY DEFAULT. When enabled it may only add narrative text; it
# can never produce a number used by a contract. No key is needed to run the
# demo, and no key should ever be committed.
# SANJEEVANI_LLM_ENABLED=false
# SANJEEVANI_LLM_ENDPOINT=
# SANJEEVANI_LLM_API_KEY=
