# Keep the build context small and the image free of local state.
#
# Note what is NOT here: `frontend/dist` is excluded because stage 1 builds it
# inside the image, and a stale local build silently winning over a fresh one is
# exactly the kind of bug that only appears in production.

.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/

# Runtime state — never bake a ledger into an image
runtime/
*.jsonl

# Local configuration and secrets
.env
.env.*
!.env.example

# Docs, tests and evidence: nothing reads these at runtime, and the evidence
# package alone is ~3 MB of source PDFs.
docs/
tests/
*.md
!README.md
